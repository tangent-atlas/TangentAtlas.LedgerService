{
  "access": { "read": ["Ledger.Read"], "write": ["Ledger.Write"] },
  "datatypes": {
    "accountType": "AtlasLedger.Model.AccountType",
    "assetType": "AtlasLedger.Model.AssetType",
    "cashType": "AtlasLedger.Model.CashType",
    "cryptoType": "AtlasLedger.Model.CryptoType",
    "date": "System.DateOnly",
    "email": { "maxLength": 128, "type": "System.String" },
    "equityType": "AtlasLedger.Model.EquityType",
    "eventSource": "AtlasLedger.Model.EventSource",
    "exerciseStyle": "AtlasLedger.Model.ExerciseStyle",
    "fixedIncomeType": "AtlasLedger.Model.FixedIncomeType",
    "fundType": "AtlasLedger.Model.FundType",
    "futureType": "AtlasLedger.Model.FutureType",
    "guid": "System.Guid",
    "int": "System.Int32",
    "lineEffect": "AtlasLedger.Model.LineEffect",
    "long": "System.Int64",
    "money": { "precision": 19, "scale": 4, "type": "System.Decimal" },
    "nodeStatus": "AtlasLedger.Model.NodeStatus",
    "nodeType": "AtlasLedger.Model.NodeType",
    "optionRight": "AtlasLedger.Model.OptionRight",
    "price": { "precision": 18, "scale": 6, "type": "System.Decimal" },
    "quantity": { "precision": 19, "scale": 6, "type": "System.Decimal" },
    "rate": { "precision": 9, "scale": 6, "type": "System.Decimal" },
    "string": "System.String",
    "time": "System.DateTimeOffset",
    "transactionKind": "AtlasLedger.Model.TransactionKind",
    "userType": "AtlasLedger.Model.UserType"
  },
  "name": "Ledger",
  "namespace": "AtlasLedger.Model",
  "tables": {
    "Account": {
      "columns": {
        "AccountId": "guid",
        "AccountType": "accountType"
      },
      "key": ["AccountId"],
      "references": {
        "Node": { "columns": ["AccountId"] }
      }
    },
    "AccountConnection": {
      "description": "Links an account to the same account at its source: the broker's account number, or the aggregator's account ID.",
      "key": ["AccountConnectionId"],
      "references": {
        "Account": { "columns": ["AccountId"] }
      },
      "unique": {
        "External": { "columns": ["Source", "ExternalAccountId"] }
      },
      "columns": {
        "AccountConnectionId": "guid",
        "AccountId": "guid",
        "ExternalAccountId": { "maxLength": 64, "type": "string" },
        "Source": "eventSource"
      }
    },
    "Alert": {
      "columns": {
        "AlertId": "guid",
        "Message": { "maxLength": 256, "type": "string" },
        "NodeId": "guid",
        "Rule": { "maxLength": 64, "type": "string" }
      },
      "description": "A compliance violation found by the rules: one per node and rule, removed when the rule is satisfied again.",
      "key": ["AlertId"],
      "references": {
        "Node": { "columns": ["NodeId"], "onDelete": "Cascade" }
      },
      "unique": {
        "Subject": { "columns": ["NodeId", "Rule"], "idempotent": true }
      }
    },
    "Asset": {
      "description": "Anything that can be held: cash, a stock, a fund, a bond, an option, a future or a coin. Its identity is a node, its Symbol rows are its names in each scheme (Currency, Ticker, Cusip), and one extension table by asset type holds what is particular to it. Market value is quantity × QuantityFactor × price × PriceFactor: QuantityFactor is the units one quantity stands for (100 shares for an option, a futures contract's multiplier), PriceFactor the units a quoted price stands for (0.01 for a bond priced per 100 of face value, or a future quoted in cents).",
      "key": ["AssetId"],
      "references": {
        "Node": { "columns": ["AssetId"] }
      },
      "columns": {
        "AssetId": "guid",
        "AssetType": "assetType",
        "PriceFactor": "quantity",
        "QuantityFactor": "quantity"
      }
    },
    "Cash": {
      "description": "An asset of type Cash: a currency, held in units of itself at a price of one.",
      "key": ["AssetId"],
      "references": {
        "Asset": { "columns": ["AssetId"] }
      },
      "columns": {
        "AssetId": "guid",
        "CashType": "cashType",
        "CurrencyCode": { "maxLength": 3, "type": "string" }
      }
    },
    "Crypto": {
      "description": "An asset of type Crypto: a coin or token on a blockchain.",
      "key": ["AssetId"],
      "references": {
        "Asset": { "columns": ["AssetId"] }
      },
      "columns": {
        "AssetId": "guid",
        "CryptoType": "cryptoType"
      }
    },
    "Dossier": {
      "access": { "read": ["Dossier.Read"], "write": ["Dossier.Write"] },
      "columns": {
        "PersonId": "guid"
      },
      "key": ["PersonId"],
      "references": {
        "Person": { "columns": ["PersonId"] }
      },
      "sync": false
    },
    "Edge": {
      "columns": {
        "ChildNodeId": "guid",
        "ParentNodeId": "guid"
      },
      "key": ["ParentNodeId", "ChildNodeId"],
      "references": {
        "Child": { "columns": ["ChildNodeId"], "table": "Node" },
        "Parent": { "columns": ["ParentNodeId"], "table": "Node" }
      }
    },
    "Equity": {
      "description": "An asset of type Equity: a share in a company.",
      "key": ["AssetId"],
      "references": {
        "Asset": { "columns": ["AssetId"] }
      },
      "columns": {
        "AssetId": "guid",
        "EquityType": "equityType"
      }
    },
    "FixedIncome": {
      "description": "An asset of type Fixed Income: a bond or note. Quantity is face value; price is per 100 of face value.",
      "key": ["AssetId"],
      "references": {
        "Asset": { "columns": ["AssetId"] }
      },
      "columns": {
        "AssetId": "guid",
        "CouponRate": "rate?",
        "FixedIncomeType": "fixedIncomeType",
        "MaturityDate": "date?"
      }
    },
    "Fund": {
      "description": "An asset of type Fund: a share in a pooled vehicle (an exchange-traded fund, a mutual fund, a money market fund).",
      "key": ["AssetId"],
      "references": {
        "Asset": { "columns": ["AssetId"] }
      },
      "columns": {
        "AssetId": "guid",
        "FundType": "fundType"
      }
    },
    "Future": {
      "description": "An asset of type Future: an agreement to buy or sell its underlying at a set price on its expiration date.",
      "key": ["AssetId"],
      "references": {
        "Asset": { "columns": ["AssetId"] },
        "Underlying": { "columns": ["UnderlyingAssetId"], "table": "Asset" }
      },
      "columns": {
        "AssetId": "guid",
        "ExpirationDate": "date",
        "FutureType": "futureType",
        "UnderlyingAssetId": "guid?"
      }
    },
    "Member": {
      "columns": {
        "PersonId": "guid?",
        "UserId": "guid",
        "UserType": "userType"
      },
      "facts": false,
      "key": ["UserId"],
      "references": {
        "Person": { "columns": ["PersonId"] },
        "User": { "columns": ["UserId"] }
      }
    },
    "Node": {
      "columns": {
        "Description": "string?",
        "DisplayName": { "maxLength": 16, "type": "string" },
        "FullName": { "maxLength": 64, "type": "string" },
        "NodeId": "guid",
        "NodeStatus": "nodeStatus",
        "NodeType": "nodeType"
      },
      "key": ["NodeId"]
    },
    "Option": {
      "description": "An asset of type Option: the right to buy (call) or sell (put) its underlying asset at the strike price until it expires.",
      "key": ["AssetId"],
      "references": {
        "Asset": { "columns": ["AssetId"] },
        "Underlying": { "columns": ["UnderlyingAssetId"], "table": "Asset" }
      },
      "columns": {
        "AssetId": "guid",
        "ExerciseStyle": "exerciseStyle",
        "ExpirationDate": "date",
        "OptionRight": "optionRight",
        "StrikePrice": "price",
        "UnderlyingAssetId": "guid"
      }
    },
    "Person": {
      "columns": {
        "Email": "email",
        "PersonId": "guid"
      },
      "key": ["PersonId"],
      "references": {
        "Node": { "columns": ["PersonId"] }
      }
    },
    "Price": {
      "columns": {
        "AsOf": "time",
        "Code": { "maxLength": 32, "type": "string" },
        "Last": "price",
        "Scheme": { "maxLength": 32, "type": "string" }
      },
      "concurrency": "LatestValue",
      "description": "The latest price of a symbol, from the market data feed. Ticks are ephemeral: never persisted, synced, or served by the API.",
      "key": ["Scheme", "Code"],
      "persistence": "Ephemeral"
    },
    "PriceOverride": {
      "description": "An event: the operator sets an asset's price from its effective time until it expires, because a source has it wrong.",
      "writeMode": "AppendOnly",
      "key": ["PriceOverrideId"],
      "references": {
        "Asset": { "columns": ["AssetId"] }
      },
      "unique": {
        "SourceRecord": { "columns": ["Source", "SourceId"], "idempotent": true }
      },
      "columns": {
        "AssetId": "guid",
        "EffectiveTime": "time",
        "EnteredTime": "time",
        "ExpiresTime": "time",
        "Price": "price",
        "PriceOverrideId": "guid",
        "Reason": { "maxLength": 256, "type": "string?" },
        "Source": "eventSource",
        "SourceId": { "maxLength": 64, "type": "string" },
        "SourceSequence": "long?"
      }
    },
    "Symbol": {
      "columns": {
        "Code": { "maxLength": 32, "type": "string" },
        "NodeId": "guid",
        "Scheme": { "maxLength": 32, "type": "string" }
      },
      "key": ["Scheme", "Code"],
      "references": {
        "Node": { "columns": ["NodeId"] }
      }
    },
    "Transaction": {
      "description": "An event: something that happened at a time, recorded once and never changed (a mistake is corrected by another transaction). One atomic unit: its lines are inserted with it, in the same batch. An exchange (a purchase or a sale) gives one asset for another, so its lines balance. A temporary entry (an override) carries ExpiresTime and is in force from its effective time until then.",
      "writeMode": "AppendOnly",
      "key": ["TransactionId"],
      "unique": {
        "SourceRecord": { "columns": ["Source", "SourceId"], "idempotent": true }
      },
      "columns": {
        "EffectiveTime": "time",
        "EnteredTime": "time",
        "ExpiresTime": "time?",
        "Kind": "transactionKind",
        "Reason": { "maxLength": 256, "type": "string?" },
        "Source": "eventSource",
        "SourceId": { "maxLength": 64, "type": "string" },
        "SourceSequence": "long?",
        "TransactionId": "guid"
      }
    },
    "TransactionLine": {
      "description": "What a transaction does to one holding: an account's quantity of one asset. Effect Change adds Quantity (negative to remove); Effect SetTo sets it (an override). Amount is the line's value in the tenant's currency at the transaction: what was received (positive) or given (negative); for a purchase, the cost; null when unknown. RelatedAssetId names another asset the line is about (the company that paid a dividend).",
      "writeMode": "AppendOnly",
      "key": ["TransactionId", "LineNumber"],
      "references": {
        "Transaction": { "columns": ["TransactionId"] },
        "Account": { "columns": ["AccountId"] },
        "Asset": { "columns": ["AssetId"] },
        "Related": { "columns": ["RelatedAssetId"], "table": "Asset" }
      },
      "columns": {
        "AccountId": "guid",
        "Amount": "money?",
        "AssetId": "guid",
        "Effect": "lineEffect",
        "LineNumber": "int",
        "Quantity": "quantity",
        "RelatedAssetId": "guid?",
        "TransactionId": "guid"
      }
    }
  },
  "version": "1.0"
}
