<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Atlas Ledger database schema (the Schema role): an Entity Framework Core model generated from the server's model
    file, and its migrations.  It is used to create and evolve the database, never to read or write the ledger: the server's
    generated LedgerSqlDatabase does that, with the same column types.
  -->
  <PropertyGroup>
    <RootNamespace>AtlasLedger.Schema</RootNamespace>
    <BellerophonRole>Schema</BellerophonRole>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server owns the model; the schema generates from the same file. -->
    <AdditionalFiles Include="..\AtlasLedger.Server\bellerophon.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bellerophon" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!--
      Entra ID sign-in for the migrations (Authentication=Active Directory Default in the release).  From SqlClient 7,
      which Entity Framework 11 uses, it is a separate package; without it the connection fails with "Cannot find an
      authentication provider for 'ActiveDirectoryDefault'".  The server gets it through Bellerophon.SqlServer.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TangentAtlas\TangentAtlas.csproj" />
  </ItemGroup>

</Project>
