<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Atlas Ledger server (the Primary role): the generated API over the in-memory ledger, write-behind persistence to
    SQL Server, the compliance engine, and the market data feed.  It owns the model: bellerophon.json in this folder,
    which the Bellerophon package includes automatically.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AtlasLedger.Server</RootNamespace>
    <BellerophonRole>Primary</BellerophonRole>
    <!-- Write the generated files to obj/.../generated so they can be inspected, diffed, and archived with each release. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- The generator.  A development dependency: it runs in the compiler and ships nothing at run time. -->
    <PackageReference Include="Quartz" />
    <PackageReference Include="Bellerophon" />
    <PackageReference Include="Bellerophon.Runtime" />
    <!-- Referencing these makes the generator emit the rules adapters and the SQL Server writer and loader. -->
    <PackageReference Include="Bellerophon.Rules.NRules" />
    <PackageReference Include="Bellerophon.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TangentAtlas\TangentAtlas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prices the feed doesn't supply (a currency's price in itself), published into every tenant at startup. -->
    <EmbeddedResource Include="Market\initial-prices.json" LogicalName="AtlasLedger.Server.Market.initial-prices.json" />
  </ItemGroup>

</Project>
